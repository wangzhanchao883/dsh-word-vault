{
  "name": "dsh-word-vault",
  "version": "0.5.3",
  "description": "英语生词库 · 多用户单词助手:拖选双击Ctrl/F9 秒录生词、拍照标记词识别、LLM 翻译落 SQLite,按录入时间/出现次数/已学会维度出趣味记忆卡(Word/HTML/PDF)并支持英译汉单选考试闭环。",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "client.js",
    "config.mjs",
    "words.mjs",
    "db.mjs",
    "translate.mjs",
    "cards.mjs",
    "cardgen.mjs",
    "examgen.mjs",
    "exam.mjs",
    "photos.mjs",
    "web.mjs",
    "capture.mjs",
    "cordis.patch.yml",
    "scripts/capture.ps1",
    "test/",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "check": "node --check index.mjs && node --check config.mjs && node --check words.mjs && node --check db.mjs && node --check translate.mjs && node --check capture.mjs",
    "test": "node --test test/"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2"
  },
  "engines": {
    "node": "^22.0.0 || >=24"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "english",
    "vocabulary",
    "word",
    "sqlite",
    "hotkey",
    "exam"
  ],
  "license": "MIT"
}
